{% schema %}
{
  "name": "Hearing Tabs Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Safeguard Your Hearing"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "so you can hear the melodies of life in full harmony"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab Item",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title"
        },
        {
          "type": "text",
          "id": "content_title",
          "label": "Content Title"
        },
        {
          "type": "textarea",
          "id": "content_text",
          "label": "Content Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hearing Tabs"
    }
  ]
}
{% endschema %}

<div class="soundlife-tabs">
  <div class="page-width">
    <h2 class="heading">{{ section.settings.heading }}</h2>
    <p class="description">{{ section.settings.subheading }}</p>

    <div class="soundlife-tabs-wrapper">
      <!-- LEFT TABS -->
      <div class="soundlife-tabs-nav">
        {% for block in section.blocks %}
          <button
            class="soundlife-tab-btn {% if forloop.first %}active{% endif %}"
            data-index="{{ forloop.index0 }}"
          >
            {{ block.settings.tab_title }}
          </button>
        {% endfor %}
      </div>

      <!-- RIGHT CONTENT -->
      <div class="soundlife-tabs-content">
        {% for block in section.blocks %}
          <div class="soundlife-tab-content {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
            <div class="tab-image">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="">
              {% endif %}
            </div>

            <div class="tab-text">
              <h3>{{ block.settings.content_title }}</h3>
              <p>{{ block.settings.content_text }}</p>

              {% if block.settings.button_link %}
                <a href="{{ block.settings.button_link }}" class="btn-primary">
                  Learn More
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.75 9H14.25" stroke="#FCFBF8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 3.75L14.25 9L9 14.25" stroke="#FCFBF8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>


