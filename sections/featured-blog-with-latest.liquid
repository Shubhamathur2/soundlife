{% comment %}
  Featured Blog Slider (left) + Latest Blog (right)
  Category-based, Shopify-native
{% endcomment %}

<section class="blog-insights section-{{ section.id }}">
  <div class="page-width">
    <!-- Header -->
    <div class="blog-insights__header">
      <div class="blog-left-content">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="heading heading-left">{{ section.settings.heading }}</h2>
        <p class="description">{{ section.settings.subheading }}</p>
      </div>
      {% unless request.path == '/blogs/featured' %}
        {% if section.settings.latest_blog != blank %}
          <a href="{{ blogs[section.settings.latest_blog].url }}" class="story-link view-all">
            View All Articles
            <svg
              class="arrow-svg blue-svg"
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M3.75 9H14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9 3.75L14.25 9L9 14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      {% endunless %}
    </div>

    <div class="blog-insights__grid">
      <!-- LEFT : Featured Blog Slider -->
      <div class="blog-insights__featured">
        <div class="featuredBlogSlider">
          {% for article in blogs[section.settings.featured_blog].articles %}
            <div class="featured-slide">
              <a href="{{ article.url }}" class="featured-card">
                <span class="badge-blog badge badge-label-secondary">Featured</span>

                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 1000 }}"
                    alt="{{ article.title }}"
                  >
                {% endif %}

                <h3 title="{{ article.title }}">{{ article.title }}</h3>
              </a>
            </div>
          {% endfor %}
        </div>

        <!-- Slick Arrows -->
        <button class="slick-prev featured-prev">‹</button>
        <button class="slick-next featured-next">›</button>

        <!-- Slick Dots -->
        <div class="featured-dots"></div>
      </div>

      <!-- RIGHT : Latest Blog -->
      <div class="blog-insights__latest">
        {% assign latest_count = 0 %}

        {% for article in blogs[section.settings.latest_blog].articles %}
          {% if latest_count < section.settings.latest_limit %}
            <a href="{{ article.url }}" class="latest-card">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 300 }}"
                  alt="{{ article.title }}"
                >
              {% endif %}

              <div class="latest-card__content">
                <h4 title="{{article.title }}">{{ article.title }}</h4>
                <p class="meta">
                  {{ article.published_at | date: '%b %d, %Y' }} •
                  {% assign words = article.content | strip_html | split: ' ' %}
                  {{ words.size | divided_by: 200 | plus: 1 }} min read
                </p>
                <span class="read-more story-link"
                  >Explore More
                  <svg
                    class="arrow-svg blue-svg"
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M3.75 9H14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M9 3.75L14.25 9L9 14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>

            {% assign latest_count = latest_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initFeaturedBlogSlider() {
      if (typeof jQuery === 'undefined' || typeof jQuery.fn.slick === 'undefined') {
        console.warn('Slick or jQuery not loaded yet');
        return;
      }

      var $ = jQuery;
      var $section = $('.section-{{ section.id }}');
      var $slider = $section.find('.featuredBlogSlider');

      if (!$slider.length) return;

      // Prevent duplicate init (Shopify editor safe)
      if ($slider.hasClass('slick-initialized')) {
        $slider.slick('unslick');
      }

      $slider.slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        infinite: true,
        autoplay: false,
        speed: 600,
        arrows: true,
        dots: true,
        adaptiveHeight: false,
        swipe: true,
        draggable: true,
        cssEase: 'ease',
        prevArrow: $section.find('.featured-prev'),
        nextArrow: $section.find('.featured-next'),
        appendDots: $section.find('.featured-dots'),
        responsive: [
          {
            breakpoint: 900,
            settings: {
              slidesToShow: 1,
            },
          },
        ],
      });
    }

    window.addEventListener('load', initFeaturedBlogSlider);
    document.addEventListener('shopify:section:load', initFeaturedBlogSlider);
  })();
</script>

<style>
      {% comment %} .story-link.view-all {
      display: none;
    } {% endcomment %}
    .blog-insights
    {
        padding:40px 0;
    }
    .blog-insights__featured{
         position: relative;
    }
    /* ===== SLICK FEATURED BLOG SLIDER ===== */
     .featuredBlogSlider {
         position: relative;
    }
     .featuredBlogSlider .slick-track {
         display: flex !important;
    }
     .featured-slide {
         padding: 0;
    }
     .featured-card {
         position: relative;
         display: block;
         border-radius: 16px;
         overflow: hidden;
         color: #fff;
         width: 100%;
    }
     .featured-card img {
         width: 100%;
         height: 490px;
         object-fit: cover;
         display: block;
    }
     .featured-card h3 {
         position: absolute;
         bottom: 50px;
         left: 20px;
         font-size: 28px;
         color: #fff;
         font-weight: 600;
         z-index: 2;
    }
    /* Custom Slick Arrows */
     .blog-insights__featured .featured-prev, .blog-insights__featured .featured-next {
         position: absolute;
         top: 50%;
         transform: translateY(-50%);
         z-index: 5;
             width: 36px;
        height: 36px;
         border-radius: 50%;
         border: none;
         background: #fff;
         color: #fff;
         cursor: pointer;
    }
     .blog-insights__featured .featured-prev {
         left: 15px;
    }
     .blog-insights__featured .featured-next {
         right: 15px;
    }
     .slick-dotted.slick-slider{
         margin-bottom: 0px;
    }
    /* Dots */
     .featured-dots {
         text-align: center;
         position: absolute;
         bottom: 30px;
         width: 100%;
    }
     .featured-dots .slick-dots {
         position: static;
    }
     .featured-dots .slick-dots li button:before {
         font-size: 10px;
         color: #fff;
         opacity: 1;
         content: none;
    }
     .featured-dots .slick-dots li.slick-active button:before {
         color: var(--color-primary);
    }
    .slick-dots {
      display: flex !important;
      justify-content: center;
      gap: 10px;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .slick-dots li {
      width: 12px;
      height: 12px;
      background: white;
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .slick-dots li.slick-active {
      width: 26px;
      height: 12px;
      background: var(--color-button-primary);
      border-radius: 20px;
    }
    /* Mobile */
     @media (max-width: 900px) {
         .featured-card img {
             height: 280px;
        }
    }
     .blog-insights {
         background-color:var(--color-cream);
    }
     .view-all {
         color: var(--color-button-hover);
         font-size: var(--font-size-base);
         text-decoration: none;
         font-weight: 600;
    }
     .swiper-slide-active {
         scale: unset !important;
    }
     .blog-insights__header {
         display: flex;
         justify-content: space-between;
         align-items: flex-end;
         margin-bottom: 32px;
    }
     .blog-insights__grid {
         display: grid;
         grid-template-columns:1fr 1fr;
         gap: 32px;
         align-items: start;
    }
    /* Featured slider */
     .featured-card {
         position: relative;
         display: block;
         border-radius: 16px;
         overflow: hidden;
         color: #fff;
    }
    .featured-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(26, 26, 26, 0.4) 0%, rgba(26, 26, 26, 0) 100%);
      pointer-events: none;
      z-index: 1;
    }
     .featured-card img {
         width: 100%;
         height: 490px !important;
         object-fit: cover;
    }
     .featured-card h3 {
         position: absolute;
         bottom: 70px;
         left: 20px;
         right: unset;
         font-size: 28px;
         color: #fff;
         font-weight:600;
    }
    /* Swiper UI */
     .swiper-button-next, .swiper-button-prev {
         color: #fff;
    }
     .swiper-pagination {
         bottom: 15px !important;
    }
     .swiper-pagination-bullet {
         background: #bbb;
         opacity: 1;
    }
     .swiper-pagination-bullet-active {
         background: var(--color-primary);
    }
    /* Latest */
     .latest-card {
         display: flex;
         gap: 16px;
         margin-bottom: 20px;
         align-items:center;
    }
     .latest-card img {
         width: 150px;
         height: 150px;
         object-fit: cover;
         border-radius: 10px;
    }
     .latest-card h4 {
         font-size: 24px;
         font-weight:600;
         color:var(--color-text-primary);
    }
     .meta {
         font-size: 18px;
         opacity: 0.7;
         color:var(--color-text-primary);
    }
     .read-more {
         margin-top: 0px;
    }
    /* ===== FIX IMAGE OVERFLOW ISSUE ===== */
     .blog-insights__featured, .blog-insights__featured .swiper, .blog-insights__featured .swiper-wrapper, .blog-insights__featured .swiper-slide {
         max-width: 100%;
         overflow: hidden;
    }
     .featured-card {
         width: 100%;
    }
     .featured-card img {
         display: block;
         width: 100%;
         max-width: 100%;
         height: auto;
         object-fit: cover;
    }
     .badge-blog {
         position: absolute;
         top: 20px !important;
         left: 0px ;
         font-size: 14px;
         right: unset;
         border-top-right-radius: 10px;
         border-bottom-right-radius: 10px;
         border-top-left-radius: 0px;
         border-bottom-left-radius: 0px;
    }
     @media (max-width: 900px) {
         .blog-insights__grid {
             grid-template-columns: 1fr;
        }
         .featured-card img {
             height: 280px;
        }
    }
     @media (max-width: 767px) {
    .latest-card img {
        width: 100px;
        height: 100px;
    	}
    	.latest-card h4{
    		font-size: 18px;
    	}
    	.meta{
    		font-size: 12px;
    	}
    	.story-link{
    		font-size: 16px
    	}
    }
    @media (max-width: 576px) {
    .featured-card h3{
  		left: 0px;
  		font-size: 24px;
  	}
  }
</style>
{% schema %}
{
  "name": "Featured Blog Slider",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "HEARING HEALTH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Insights For Better Hearing"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Providing in-depth insights on hearing loss, early diagnosis, hearing aid solutions, and community-driven support programs designed to help individuals reconnect with conversations, classrooms, and everyday life."
    },
    {
      "type": "blog",
      "id": "featured_blog",
      "label": "Featured Blog (Left)"
    },
    {
      "type": "blog",
      "id": "latest_blog",
      "label": "Latest Blog (Right)"
    },
    {
      "type": "range",
      "id": "latest_limit",
      "label": "Latest articles limit",
      "min": 1,
      "max": 5,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Featured Blog Slider + Latest"
    }
  ]
}
{% endschema %}
