{% comment %}
  Hearing CTA Section - Background Image Version
{% endcomment %}

<section class="hearing-cta-section">
  <div class="page-width">
    <div class="hearing-cta-wrapper {% if section.settings.layout == 'reverse' %}reverse{% endif %}">
      <!-- Left Content -->
      <div class="hearing-cta-content">
        {% if section.settings.subheading != blank %}
          <p class="eyebrow">
            {{ section.settings.subheading }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="heading heading-left">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hearing-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <ul class="hearing-features">
            {% for block in section.blocks %}
              <li class="hearing-feature" {{ block.shopify_attributes }}>
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="26" height="26" rx="13" fill="#01AD01" fill-opacity="0.12"/>
                  <rect x="6.5" y="6.5" width="13" height="13" rx="6.5" fill="#01AD01"/>
                </svg>

                {{ block.settings.text }}
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        <div class="hearing-buttons">
          {% if section.settings.primary_btn_label != blank %}
            <a href="{{ section.settings.primary_btn_link }}" class="btn-primary soundlife-btn-primary">
              {{ section.settings.primary_btn_label }}
              <svg
                class="arrow-svg white-svg"
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M3.75 9H14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 3.75L14.25 9L9 14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}

          {% if section.settings.secondary_btn_label != blank %}
            <a href="{{ section.settings.secondary_btn_link }}" class="hear-btn-secondary soundlife-btn-secondary">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.666992 8.00033H2.66699C3.02061 8.00033 3.35975 8.1408 3.6098 8.39085C3.85985 8.6409 4.00033 8.98004 4.00033 9.33366V11.3337C4.00033 11.6873 3.85985 12.0264 3.6098 12.2765C3.35975 12.5265 3.02061 12.667 2.66699 12.667H2.00033C1.6467 12.667 1.30756 12.5265 1.05752 12.2765C0.807468 12.0264 0.666992 11.6873 0.666992 11.3337V6.66699C0.666992 5.07569 1.29913 3.54957 2.42435 2.42435C3.54957 1.29913 5.07569 0.666992 6.66699 0.666992C8.25829 0.666992 9.78441 1.29913 10.9096 2.42435C12.0349 3.54957 12.667 5.07569 12.667 6.66699V11.3337C12.667 11.6873 12.5265 12.0264 12.2765 12.2765C12.0264 12.5265 11.6873 12.667 11.3337 12.667H10.667C10.3134 12.667 9.97423 12.5265 9.72418 12.2765C9.47414 12.0264 9.33366 11.6873 9.33366 11.3337V9.33366C9.33366 8.98004 9.47414 8.6409 9.72418 8.39085C9.97423 8.1408 10.3134 8.00033 10.667 8.00033H12.667" stroke="#2FB215" stroke-opacity="0.9" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {{ section.settings.secondary_btn_label }}
            </a>
          {% endif %}

            {% if section.settings.description_2 != blank %}
              <div class="hearing-description bottom-para">
                {{ section.settings.description_2 }}
              </div>
            {% endif %}
        </div>
      </div>

      <!-- Right Background Image -->
      <div
        class="hearing-cta-image"
        {% if section.settings.image != blank %}
          style="background-image: url('{{ section.settings.image | image_url: width: 1500 }}');"
        {% endif %}
      ></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hearing CTA Section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "normal",
          "label": "Content Left, Image Right"
        },
        {
          "value": "reverse",
          "label": "Image Left, Content Right"
        }
      ],
      "default": "normal"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "START YOUR JOURNEY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready To Hear Life Again?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Book your free consultation today. Our experts will guide you through a personalized hearing assessment and help you discover the perfect solution for your lifestyle.</p>"
    },
    {
      "type": "richtext",
      "id": "description_2",
      "label": "Description",
      "default": "<p></p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Background Image"
    },
    {
      "type": "text",
      "id": "primary_btn_label",
      "label": "Primary Button Label",
      "default": "Book Appointment"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_label",
      "label": "Secondary Button Label",
      "default": "Free Hearing Test"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Free hearing assessment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hearing CTA Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
