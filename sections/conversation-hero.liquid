<section
  class="hero-conversation"
  style="
    background-image: url({{ section.settings.image | image_url: width: 2000 }});
    background-color: {{ section.settings.bg_color }};
  "
>
  <div class="hero-overlay"></div>

  <div class="hero-conversation__inner page-width">
    <div class="hero-conversation__content">
      {% if section.settings.tagline != blank %}
        <p class="eyebrow">{{ section.settings.tagline }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="heading heading-left">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="hero-text">{{ section.settings.text }}</p>
      {% endif %}

      {% if section.settings.show_scroll %}
        {% comment %} <div class="hero-scroll"> {% endcomment %}
          <a href="{{ section.settings.button_link }}" class=" hero-scroll">
            <span class="scroll-dot"></span>
            <span>{{ section.settings.scroll_text }}</span>
          </a>
        {% comment %} </div> {% endcomment %}
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="hero-btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Conversation (BG)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback Background",
      "default": "#f8f8f8"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "WE'RE LISTENING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's Start a Conversation"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Every great hearing journey begins with a simple hello."
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Show Scroll Indicator",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scroll Text",
      "default": "SCROLL TO EXPLORE"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Conversation (BG)"
    }
  ]
}
{% endschema %}
