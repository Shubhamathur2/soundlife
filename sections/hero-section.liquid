<section class="hero-section section-space-two">
 

  <div class="hero-accordion first-acc hero-section page-width">
    {% if section.settings.heading != blank %}
      <h2 class="hero-section-heading">
        {{ section.settings.heading }}
        <span class="hero-heading-highlight">
          {{ section.settings.heading_highlight }}
        </span>
      </h2>
    {% endif %}
    <ul>
      {% for block in section.blocks %}
        <li
          class="{% if forloop.index == section.settings.default_active_index %}active-element{% endif %}"
          style="background-image:url('{{ block.settings.image | image_url }}')"
        >
          <div class="sliderLink">
            <h2>{{ block.settings.heading }}</h2>
          </div>

          <span>{{ block.settings.label }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>

  {% comment %} <script>
    document.addEventListener('DOMContentLoaded', function () {
      const items = document.querySelectorAll('.hero-section.first-acc li');

      items.forEach((item) => {
        item.addEventListener('mouseenter', () => {
          items.forEach((i) => i.classList.remove('active-element'));
          item.classList.add('active-element');
        });
      });
    });
  </script> {% endcomment %}
</section>

{% schema %}
{
  "name": "Hero Section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Dengar dengan Baik,"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted text",
      "default": "Hidup dengan Baik"
    },
    {
  "type": "range",
  "id": "default_active_index",
  "label": "Default active slide",
  "min": 1,
  "max": 3,
  "step": 1,
  "default": 2
}

  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Hero Title"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Side Label",
          "default": "Hero"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "category": "Hero"
    }
  ]
}
{% endschema %}
