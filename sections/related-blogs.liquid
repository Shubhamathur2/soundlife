{% if blog and blog.articles_count > 1 %}
  <div class="related-blog-container page-width">
    <div class="related-blog-grid">
      {% assign current_article_id = article.id %}
      {% assign count = 0 %}

      {% for article in blog.articles %}
        {% if article.id != current_article_id %}
          {% if count < section.settings.posts_to_show %}
            <div class="blog-card">
              <a href="{{ article.url }}">
                <div class="blog-image">
                  {% if article.tags.size > 0 %}
                    <span class="badge-float">
                      {{ article.tags.first }}
                    </span>
                  {% endif %}

                  {% if article.image %}
                    {{ article.image | image_url: width: 600 | image_tag: alt: article.title }}
                  {% endif %}
                  <span class="read-time">{% assign words = article.content | strip_html | split: ' ' %}
                  {{ words.size | divided_by: 200 | plus: 1 }} min read</span>
                </div>
              </a>

              <div class="blog-content">
                <h3>
                  <a href="{{ article.url }}">{{ article.title | truncate: 40 }}</a>
                </h3>

                <!-- DATE + READ TIME -->
                <span class="blog-date">
                  {{ article.published_at | date: '%B %d, %Y' }}
                  •
                  {{  article.author }}
                </span>

                <p class="blog-desc">
                  {% if article.excerpt != blank %}
                    {{ article.excerpt | strip_html }}
                  {% else %}
                    {{ article.content | strip_html | truncate: 120 }}
                  {% endif %}
                </p>

                <a class="read-btn" href="{{ article.url }}">
                  Read Full Blog
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3.3335 8H12.6668" stroke="#2FB215" stroke-width="1.33333" stroke-linecap="round"/>
                    <path d="M8 3.3335L12.6667 8.00016L8 12.6668" stroke="#2FB215" stroke-width="1.33333" stroke-linecap="round"/>
                  </svg>
                </a>
              </div>
            </div>

            {% assign count = count | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_view_all %}
      <div class="custom-pagination" style="text-align:center; margin-top:20px;">
        <a class="btn-primary" href="{{ blog.url }}">
          {{ section.settings.view_all_text }}
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.75 9H14.25" stroke="#FCFBF8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 3.75L14.25 9L9 14.25" stroke="#FCFBF8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
{% endif %}



{% schema %}
{
  "name": "Related Blogs",
  "settings": [
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Number of posts",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All text",
      "default": "View All"
    }
  ],
  "presets": [
    {
      "name": "Related Blogs"
    }
  ]
}
{% endschema %}
