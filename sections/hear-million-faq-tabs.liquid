<section class="faq-wrap">

<div class="page-width">
<h2 class="faq-title heading">{{ section.settings.faq_heading }}</h2>
<p class="description desc-center">{{ section.settings.faq_desc }}</p>

<div class="faq-grid">

<!-- LEFT (Optional QR – kept for future use if needed) -->
{% comment %} <div>

  <div class="qr-card">
    {% if section.settings.qr %}
      <img src="{{ section.settings.qr | image_url: width: 260 }}">
    {% endif %}
    <p><b>Scan to connect with us on WhatsApp</b></p>
    <small>Get instant support</small>
  </div>
</div> {% endcomment %}

<!-- RIGHT -->
<div>

{% for block in section.blocks %}
  <div class="faq-q {% if forloop.first %}first{% endif %} {% if forloop.last %}last{% endif %}">
    {{ block.settings.q }}
    <span class="faq-icon">+</span>
  </div>

  <div class="faq-a {% if forloop.last %}last{% endif %}">
    <div class="faq-a-inner">
      {{ block.settings.a }}
    </div>
  </div>
{% endfor %}

<div class="explore-more-link">
    {% if section.settings.explore_btn != blank %}
  <a href="#">
    {{ section.settings.explore_btn }}
    <svg class="arrow-svg blue-svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
      <path d="M3.75 9H14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M9 3.75L14.25 9L9 14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </a>
  {% endif %}
</div>

</div>
</div>
</div>
</section>

{% schema %}
{
  "name": "FAQ Simple Accordion",
  "settings": [
    {
        "type": "text",
        "id": "faq_heading",
        "label": "FAQ Heading",
        "default": "Questions?"
    },
    {
        "type": "text",
        "id": "faq_desc",
        "label": "FAQ Description",
        "default": "We’ve got the answers you’re looking for."
    },
    {
      "type": "image_picker",
      "id": "qr",
      "label": "WhatsApp QR Image"
    },
    {
      "type": "text",
      "id": "explore_btn",
      "label": "Explore Button Text",
      "default": "All FAQ here"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "q", "label": "Question" },
        { "type": "textarea", "id": "a", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Simple Accordion"
    }
  ]
}
{% endschema %}

<script>
    document.addEventListener("DOMContentLoaded", function () {

    const questions = document.querySelectorAll(".faq-q");

    questions.forEach((q) => {
        q.addEventListener("click", function () {

        const answer = this.nextElementSibling;
        const icon = this.querySelector(".faq-icon");

        // Close all others
        document.querySelectorAll(".faq-a").forEach(a => {
            if (a !== answer) {
            a.style.maxHeight = null;
            a.previousElementSibling.classList.remove("open");
            a.previousElementSibling.querySelector(".faq-icon").textContent = "+";
            }
        });

        if (answer.style.maxHeight) {
            answer.style.maxHeight = null;
            icon.textContent = "+";
        } else {
            answer.style.maxHeight = answer.scrollHeight + "px";
            icon.textContent = "-";
        }

        this.classList.toggle("open");
        });
    });

    });
</script>