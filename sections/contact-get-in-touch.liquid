<section class="get-in-touch section-space-two">
  <div class="page-width get-in-touch__wrapper">
    <!-- LEFT CONTENT -->
    <div class="get-in-touch__content">
      {% if section.settings.tagline != blank %}
        <p class="eyebrow">{{ section.settings.tagline }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="heading heading-left">
          <em>{{ section.settings.heading }}</em>
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="description">{{ section.settings.description }}</p>
      {% endif %}

      <!-- GREEN CARD -->
      <div class="contact-highlight">
        <p class="highlight-label">{{ section.settings.highlight_title }}</p>
        <p class="highlight-text">{{ section.settings.highlight_text }}</p>
        <p class="highlight-sub">{{ section.settings.highlight_subtext }}</p>
      </div>
    </div>

    <!-- RIGHT FORM -->
    <div class="get-in-touch__form">
      {% form 'contact', id: 'ContactForm' %}
        <div class="form-grid">
          <div class="field">
            <label>Full Name *</label>
            <input type="text" name="contact[name]" placeholder="Your full name">
          </div>

          <div class="field">
            <label>Email *</label>
            <input type="email" name="contact[email]" placeholder="your@email.com" required>
          </div>

          <div class="field">
            <label>Phone</label>
            <input
              type="tel"
              name="contact[phone]"
              placeholder="+62 xxx xxxx xxxx"
              inputmode="numeric"
              pattern="[0-9+ ]*"
              oninput="this.value = this.value.replace(/[^0-9+ ]/g, '')"
            >
          </div>

          <div class="field">
            <label>Subject</label>
            <input type="text" name="contact[subject]" placeholder="Hearing consultation, product inquiry...">
          </div>
        </div>

        <div class="field full">
          <label>Your Message *</label>
          <textarea name="contact[body]" placeholder="Tell us how we can help..."></textarea>
        </div>

        <div class="form-footer">
          <button type="submit" class="btn-primary">
            {{ section.settings.button_label }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.3335 8H12.6668" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8 3.3335L12.6667 8.00016L8 12.6668" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="form-note">{{ section.settings.note }}</span>
        </div>
        {%- if form.posted_successfully? -%}
          <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{- 'icon-success.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.post_success' | t }}
          </h2>
        {%- elsif form.errors -%}
          <div class="form__message">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Get in Touch",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's Start a Conversation"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "highlight_title",
      "label": "Highlight Title",
      "default": "Quick Response"
    },
    {
      "type": "textarea",
      "id": "highlight_text",
      "label": "Highlight Text"
    },
    {
      "type": "text",
      "id": "highlight_subtext",
      "label": "Highlight Subtext"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Send Message"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Bottom Note",
      "default": "We respond within 24 hours"
    }
  ],
  "presets": [
    {
      "name": "Get in Touch"
    }
  ]
}
{% endschema %}
