<section class="faq-wrap">

<div class="page-width">
<h2 class="faq-title heading">Frequently Asked Questions</h2>

<div class="faq-grid">

<!-- LEFT -->
<div>
  <div class="faq-tabs">
    <div class="faq-pill active" data-tab="new">New User</div>
    <div class="faq-pill" data-tab="existing">Existing User</div>
  </div>

  {% comment %} <div class="qr-card">
    {% if section.settings.qr %}
      <img src="{{ section.settings.qr | image_url: width: 260 }}">
    {% endif %}
    <p><b>Scan to connect with us on WhatsApp</b></p>
    <small>Get instant support</small>
  </div> {% endcomment %}
</div>

<!-- RIGHT -->
<div>

<!-- NEW USER -->
<div data-group="new">
{% assign new_blocks = section.blocks | where: "type", "newfaq" %}
{% for block in new_blocks %}
<div class="faq-q {% if forloop.first %}first{% endif %} {% if forloop.last %}last{% endif %}">
  {{ block.settings.q }}
  <span class="faq-icon">+</span>
</div>
<div class="faq-a {% if forloop.last %}last{% endif %}">
  <div class="faq-a-inner">{{ block.settings.a }}</div>
</div>
{% endfor %}
</div>

<!-- EXISTING USER -->
<div data-group="existing" style="display:none;">
{% assign existing_blocks = section.blocks | where: "type", "existingfaq" %}
{% for block in existing_blocks %}
<div class="faq-q {% if forloop.first %}first{% endif %} {% if forloop.last %}last{% endif %}">
  {{ block.settings.q }}
  <span class="faq-icon">+</span>
</div>
<div class="faq-a {% if forloop.last %}last{% endif %}">
  <div class="faq-a-inner">{{ block.settings.a }}</div>
</div>
{% endfor %}
</div>
<div class="explore-more-link">
  <a href="#">{{ section.settings.explore_btn }} <svg class="arrow-svg blue-svg" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M3.75 9H14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M9 3.75L14.25 9L9 14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg></a>
</div>
</div>
</div>
</div>
</section>


{% schema %}
{
"name": "FAQ Tabs Pro Animated",
"settings": [
{
"type": "image_picker",
"id": "qr",
"label": "WhatsApp QR Image"
},
{
"type": "text",
"id": "explore_btn",
"label": "Explore Button Text",
"default": "All FAQ here"
}
],
"blocks": [
{
"type": "newfaq",
"name": "New User FAQ",
"settings": [
{"type":"text","id":"q","label":"Question"},
{"type":"textarea","id":"a","label":"Answer"}
]
},
{
"type": "existingfaq",
"name": "Existing User FAQ",
"settings": [
{"type":"text","id":"q","label":"Question"},
{"type":"textarea","id":"a","label":"Answer"}
]
}
],
"presets": [{"name":"FAQ Tabs Pro Animated"}]
}
{% endschema %}
