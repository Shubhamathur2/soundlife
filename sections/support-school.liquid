          </div>
          <h3>{{ section.settings.highlight_heading }}</h3>
          <p>{{ section.settings.highlight_text }}</p>
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="ss-right">
      <h2 class="heading heading-left">{{ section.settings.heading }}</h2>
      <p class="subtitle">{{ section.settings.subtext }}</p>

      <ul class="points">
        {% for block in section.blocks %}
          <li>
            <span class="dot"></span>
            {{ block.settings.text }}
          </li>
        {% endfor %}
      </ul>
    </div>

  </div>
  </div>
</section>
