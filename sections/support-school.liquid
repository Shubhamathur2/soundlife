{% schema %}
{
  "name": "Support at School",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Support at School"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description"
    },
    {
      "type": "textarea",
      "id": "highlight_heading",
      "label": "Green Box Title"
    },
    {
      "type": "textarea",
      "id": "highlight_text",
      "label": "Green Box Text"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Point"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Support at School"
    }
  ]
}
{% endschema %}

<section class="support-school section-space-two">
  <div class="page-width">
  <div class="hearing-flex">

    <!-- LEFT -->
    <div class="ss-left">
      <div class="img-wrap">
        {% if section.settings.main_image %}
          <img src="{{ section.settings.main_image | img_url: '600x' }}">
        {% endif %}

        <!-- BACK SHAPE -->
        <div class="bg-shape"></div>

