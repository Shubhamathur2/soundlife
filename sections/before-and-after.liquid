{%- comment -%} JSON Settings {%- endcomment -%}
<script type="application/json" data-wsp-section="{{ section_id }}">
  {
    "id": {{ section_id | json }},
    "animation": {{ section.settings.animation | json }}
  }
</script>

{%- comment -%} JavaScript {%- endcomment -%}
<script
  data-wsp-section-js="{{ section_id }}"
  type="module"
  defer
>
  (function(){

    const webPack = {
      settings: {},

      // ==========================
      // ✅ ADDED: Product gallery slider
      // ==========================
      initProductGallery: function(section) {
        const gallery = section.querySelector('.wsp-product-gallery');
        if (!gallery) return;

        const track = gallery.querySelector('.wsp-product-gallery-track');
        const slides = gallery.querySelectorAll('.wsp-product-gallery__item');
        const prev = gallery.querySelector('.wsp-gallery-arrow--prev');
        const next = gallery.querySelector('.wsp-gallery-arrow--next');

        if (!track || slides.length <= 1) return;

        let index = 0;

        function update() {
          track.style.transform = `translateX(-${index * 100}%)`;
        }

        prev?.addEventListener('click', () => {
          index = index > 0 ? index - 1 : slides.length - 1;
          update();
        });

        next?.addEventListener('click', () => {
          index = index < slides.length - 1 ? index + 1 : 0;
          update();
        });
      },

      load: function(section){

          const compares = section.querySelectorAll('.wsp-section__compare');
          if (!compares.length) return;

          compares.forEach(compare => {

            const overlay = compare.querySelector('.wsp-section__comparison__overlay');
            const slider  = compare.querySelector('.wsp-section__comparison__slider');

            if (!overlay || !slider) return;

            let dragging = false;

            function set(percent) {
              overlay.style.width = percent + '%';
              slider.style.left = `calc(${percent}% - 25px)`;

              // ✅ ADD THIS
  if (percent <= 0 || percent >= 100 ) {
    overlay.style.borderRadius = '16px';
  } else {
    overlay.style.borderRadius = '0';
  }
            }

            // init
            set(50);

            function percentFromEvent(e) {
              const rect = compare.getBoundingClientRect();
              const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
              return Math.max(0, Math.min(100, (x / rect.width) * 100));
            }

            slider.addEventListener('mousedown', e => {
              e.preventDefault();
              dragging = true;
            });

            slider.addEventListener('touchstart', () => {
              dragging = true;
            }, { passive: true });

            document.addEventListener('mouseup', () => dragging = false);
            document.addEventListener('touchend', () => dragging = false);

            document.addEventListener('mousemove', e => {
              if (!dragging) return;
              set(percentFromEvent(e));
            });

            document.addEventListener('touchmove', e => {
              if (!dragging) return;
              set(percentFromEvent(e));
            }, { passive: true });

      });

  webPack.initProductGallery(section);
},


      unload: function(section){
        section.classList.remove('wsp-section__animation-applied');
      }
    };

    window.addEventListener('shopify:section:unload', function (e) {
      const section = document.querySelector(`#DP--${e.detail.sectionId}`);
      if (section) webPack.unload(section);
    });

    webPack.settings = JSON.parse(
      document.querySelector('[data-wsp-section="{{ section_id }}"]').innerHTML
    );

    const sectionId = {{ section.id | json }};
    const section = document.querySelector(`#DP--${sectionId}`);

    if (sectionId === webPack.settings.id){
      webPack.load(section);
    }

  })()

  document.addEventListener('DOMContentLoaded', () => {
  const tabs = document.querySelectorAll('.wsp-tabs__btn');
  const panels = document.querySelectorAll('.wsp-tabs__panel');

  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.tab;

      tabs.forEach(b => b.classList.remove('is-active'));
      panels.forEach(p => p.classList.remove('is-active'));

      btn.classList.add('is-active');
      document.getElementById(id).classList.add('is-active');
    });
  });
});
</script>

