<section class="why-wrap section-space-two">
  <div class="page-width">
    <div class="why-container">
      <!-- LEFT CONTENT -->
      <div>
        <h2 class="heading heading-left">
          {{ section.settings.title }}
        </h2>
        <div class="description">
          {{ section.settings.desc }}
        </div>
        <ul class="why-list">
          {% for block in section.blocks %}
            <li>
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="26" height="26" rx="13" fill="#01AD01" fill-opacity="0.12"></rect>
                <rect x="6.5" y="6.5" width="13" height="13" rx="6.5" fill="#01AD01"></rect>
              </svg>
              {{ block.settings.point }}
            </li>
          {% endfor %}
        </ul>
        {% if section.settings.btn_text != blank %}
          <a href="{{ section.settings.btn_link }}" class="btn-primary">
            {{ section.settings.btn_text }}
            <svg
              class="arrow-svg white-svg"
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M3.75 9H14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9 3.75L14.25 9L9 14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>
      <!-- RIGHT IMAGES -->
      <div class="why-images">
        {% if section.settings.img1 %}
          <img
            class="why-img main ring"
            src="{{ section.settings.img1 | image_url: width: 900 }}"
          >
        {% endif %}
        {% if section.settings.img2 %}
          <img
            class="why-img small ring"
            src="{{ section.settings.img2 | image_url: width: 900 }}"
          >
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Why Choose Us?" },
    { "type": "textarea", "id": "desc", "label": "Description" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Contact Us" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "image_picker", "id": "img1", "label": "Large Image" },
    { "type": "image_picker", "id": "img2", "label": "Small Image" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet Point",
      "settings": [{ "type": "text", "id": "point", "label": "Point" }]
    }
  ],
  "presets": [{ "name": "Why Choose Us" }]
}
{% endschema %}
