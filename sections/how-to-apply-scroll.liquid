<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<section class="how-apply-scroll">
  <div class="apply-container">
    
    <!-- LEFT CONTENT -->
    <div class="apply-left">
      <h2 class="apply-heading">{{ section.settings.heading }}</h2>
      <p class="apply-subtext">{{ section.settings.subtext }}</p>

      <div class="steps-wrapper">
        {% for block in section.blocks %}
          <div class="step-card" data-step="{{ forloop.index0 }}">
            <div class="step-badge">{{ forloop.index }}</div>
            <div class="step-text">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>
            </div>
          </div>
        {% endfor %}
      </div>

      <a href="{{ section.settings.button_link }}" class="apply-btn">
        {{ section.settings.button_text }}
      </a>
    </div>

    <!-- RIGHT IMAGE -->
    <div class="apply-right">
      {% for block in section.blocks %}
        <div class="step-image {% if forloop.first %}active{% endif %}">
          <img 
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.title }}"
            loading="lazy"
          >
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
    .how-apply-scroll {
  height: 300vh; /* IMPORTANT: creates scroll space */
  position: relative;
  background: #f4f4f4;
}

.apply-container {
  position: sticky;
  top: 0;
  height: 100vh; /* Full screen fixed section */
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 80px;
  max-width: 1200px;
  margin: auto;
  padding: 60px 20px;
}

.apply-left {
  max-width: 520px;
}

.apply-heading {
  font-size: 56px;
  line-height: 1.1;
  margin-bottom: 20px;
}

.apply-subtext {
  font-size: 18px;
  color: #555;
  margin-bottom: 40px;
}

.step-card {
  display: flex;
  gap: 20px;
  padding: 24px;
  border-radius: 18px;
  background: #fff;
  margin-bottom: 20px;
  opacity: 0.3;
  transform: translateY(40px);
  transition: all 0.4s ease;
}

.step-card.active {
  background: #10b410;
  color: #fff;
  opacity: 1;
  transform: translateY(0);
}

.step-badge {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.apply-right {
  position: relative;
  height: 520px;
  border-radius: 24px;
  overflow: hidden;
}

.step-image {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.6s ease;
}

.step-image.active {
  opacity: 1;
}

.step-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.apply-btn {
  display: inline-block;
  margin-top: 30px;
  background: #1bb51b;
  color: #fff;
  padding: 16px 34px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 600;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector(".how-apply-scroll");
  const steps = gsap.utils.toArray(".step-card");
  const images = gsap.utils.toArray(".step-image");

  if (!section || steps.length === 0) return;

  // Create master timeline
  let tl = gsap.timeline({
    scrollTrigger: {
      trigger: section,
      start: "top top",
      end: "bottom bottom",
      scrub: true, // SMOOTH scrolling (important)
      pin: ".apply-container", // locks section at 100vh
      anticipatePin: 1
    }
  });

  steps.forEach((step, i) => {
    tl.to({}, { duration: 1 }); // scroll segment per step

    tl.call(() => {
      // Activate step
      steps.forEach(s => s.classList.remove("active"));
      step.classList.add("active");

      // Change image
      images.forEach(img => img.classList.remove("active"));
      if (images[i]) images[i].classList.add("active");
    });
  });

  // Set first active initially
  steps[0].classList.add("active");
  images[0].classList.add("active");
});
</script>

{% schema %}
{
  "name": "How to Apply - Scroll",
  "tag": "section",
  "class": "section-how-apply-scroll",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Apply for Hearing Support"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Our collective giving means children can chase dreams, and seniors can remain part of their families’ lives."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Apply Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Scroll Section Height (vh)",
      "min": 200,
      "max": 600,
      "step": 50,
      "default": 300,
      "info": "Controls scroll length. Higher = slower smoother step transitions."
    },
    {
      "type": "checkbox",
      "id": "enable_pin_mobile",
      "label": "Enable 100vh Pin on Mobile",
      "default": false,
      "info": "Recommended OFF for better mobile scrolling experience"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Record a Short Video (1 Minute)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Tell us about the hearing challenges you or your loved one are experiencing."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Right Side Image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Step Icon (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to Apply - Smooth Scroll",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}