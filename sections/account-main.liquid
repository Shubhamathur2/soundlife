<script>
  document.addEventListener('DOMContentLoaded', function () {
    const buttons = document.querySelectorAll('.sl-tabs button');

    buttons.forEach((btn) => {
      btn.addEventListener('click', function () {
        buttons.forEach((b) => b.classList.remove('active'));
        this.classList.add('active');

        document.querySelectorAll('.sl-tab').forEach((tab) => {
          tab.classList.remove('active');
        });

        let tabId = this.dataset.tab;
        document.getElementById(tabId).classList.add('active');

        // ✅ Load wishlist when tab opens
        if (tabId === 'wishlist') {
          loadWishlist();
          moveSwymWishlist();
        }
      });
    });

    /* -------------------------------
       WAIT FOR SWYM LOAD
    --------------------------------*/
    let interval = setInterval(function () {
      if (window.SwymWishlist) {
        clearInterval(interval);

        loadWishlist();
        moveSwymWishlist();
      }
    }, 300);
  });

  /* -------------------------------
     ORDER TOGGLE (UNCHANGED)
  --------------------------------*/
  function toggleOrder(el) {
    let parent = el.closest('.sl-order-card');
    let content = parent.querySelector('.sl-order-items');

    let isOpen = parent.classList.contains('active');

    document.querySelectorAll('.sl-order-card').forEach((card) => {
      card.classList.remove('active');
      card.querySelector('.sl-order-items').style.display = 'none';
    });

    if (!isOpen) {
      parent.classList.add('active');
      content.style.display = 'block';
    }
  }

  /* -------------------------------
     LOAD WISHLIST (CUSTOM GRID)
  --------------------------------*/
  window.loadWishlist = function () {
    if (!window.SwymWishlist) return;

    let container = document.getElementById('sl-wishlist-grid');
    if (!container) return;

    window.SwymWishlist.getWishlist(function (products) {
      container.innerHTML = '';

      if (!products.length) {
        container.innerHTML = '<p>No wishlist items found</p>';
        return;
      }

      products.forEach(function (item) {
        let html = `
  <div class="sl-wishlist-card">

    <div class="sl-card-image">
      <img src="${item.iu}" alt="${item.dt}">

      <div class="sl-wishlist-heart" onclick="removeWishlist('${item.epi}')">
        ❤️
      </div>
    </div>

    <div class="sl-card-content">
      <p class="sl-title">${item.dt}</p>

      <p class="sl-desc">
        Lorem Ipsum is simply dummy text of the printing and typesetting industry.
      </p>

      <div class="sl-rating">
        ⭐⭐⭐⭐☆ 
        <span>| 12 reviews</span>
      </div>

      <p class="sl-price">${formatMoney(item.pr)}</p>
    </div>

  </div>
`;

        container.insertAdjacentHTML('beforeend', html);
      });
    });
  };

  /* -------------------------------
     MOVE SWYM UI INTO YOUR SECTION
  --------------------------------*/
  window.moveSwymWishlist = function () {
    let swymContainer = document.querySelector('#swym-storefront-layout-items-container');
    let customContainer = document.getElementById('custom-wishlist-container');

    if (!swymContainer || !customContainer) return;

    customContainer.innerHTML = '';
    customContainer.appendChild(swymContainer);
  };

  /* -------------------------------
     REMOVE ITEM
  --------------------------------*/
  window.removeWishlist = function (epi) {
    if (!window.SwymWishlist) return;

    window.SwymWishlist.removeFromWishlist({ epi: epi }, function () {
      loadWishlist();
      moveSwymWishlist();
    });
  };

  /* -------------------------------
     FORMAT MONEY
  --------------------------------*/
  function formatMoney(price) {
    return 'Rp ' + (price / 100).toLocaleString('id-ID');
  }

  /* -------------------------------
     SHOPIFY ADDRESS SCRIPT (UNCHANGED)
  --------------------------------*/
  window.addEventListener('load', () => {
    typeof CustomerAddresses !== 'undefined' && new CustomerAddresses();
  });
</script>

