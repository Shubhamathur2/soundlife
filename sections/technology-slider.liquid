<section class="tech-slider section-space-two">
  <div class="page-width">
    <div class="tech-header">
      <h2 class="heading">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="swiper techSwiper">
     <div class="swiper-wrapper">

      {% for collection in collections %}
        {% if collection.products_count > 0 %}
          <div class="swiper-slide tech-card">

            <div class="tech-image">
              {% if collection.metafields.custom.badge != blank %}
                <span class="badge-label-secondary">
                  {{ collection.metafields.custom.badge }}
                </span>
              {% endif %}
              
              {{ collection.image
                | default: collection.products.first.featured_image
                | image_url: width: 900
                | image_tag: loading: 'lazy' }}
                <h3 class="collection-title">{{ collection.title }}</h3>
               <h4 class="collection-company-name">{{ collection.metafields.custom.company_name.value }}</h4>
               <h4 class="collection-short-desc">{{ collection.metafields.custom.short_description.value }}</h4>
            </div>

            <div class="tech-content">

              {% if collection.description != blank %}
                <p>
                  {{ collection.description | strip_html | truncate: 120 }}
                </p>
              {% endif %}

              <a href="{{ collection.url }}" class="tech-link">
                Explore {{ collection.title }} <svg class="arrow-svg blue-svg" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.33301 8H12.6663" stroke="#01AD01" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M8 3.33301L12.6667 7.99967L8 12.6663" stroke="#01AD01" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

              </a>
            </div>

          </div>
        {% endif %}
      {% endfor %}
      {% for block in section.blocks %}
  {% if block.type == 'cta_slide' %}
    <div class="swiper-slide tech-card tech-card--cta" {{ block.shopify_attributes }}>
      <div class="tech-cta-box">
        
        {% if block.settings.eyebrow != blank %}
          <span class="tech-cta-eyebrow">
            {{ block.settings.eyebrow }}
          </span>
        {% endif %}

        {% if block.settings.title != blank %}
          <h3 class="tech-cta-title">
            {{ block.settings.title }}
          </h3>
        {% endif %}

        {% if block.settings.button_label != blank %}
          <a href="{{ block.settings.button_link }}" class="btn-primary">
            {{ block.settings.button_label }} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3.33301 8H12.6663" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M8 3.33301L12.6667 7.99967L8 12.6663" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>

          </a>
        {% endif %}

      </div>
    </div>
  {% endif %}
{% endfor %}
</div>

   <div class="swiper-button-prev tech-prev"></div>
  <div class="swiper-button-next tech-next"></div>

      <div class="swiper-pagination"></div>
    </div>

  </div>
</section>

<style>
.tech-card--cta {
  display: flex;
  align-items: stretch;
}

.tech-cta-box {
  width: 100%;
  min-height: 520px;
  border-radius: 20px;
  padding: 40px 30px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  background-color: #fff;
}

.tech-cta-eyebrow {
  font-size: 12px;
  letter-spacing: 2px;
  color: #8c8c8c;
  margin-bottom: 16px;
}

.tech-cta-title {
  font-size: 20px;
  font-weight: 600;
  max-width: 420px;
  margin-bottom: 28px;
  line-height: 1.4;
}

.tech-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--color-primary);
  color: #fff;
  padding: 14px 26px;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 600;
  transition: 0.3s ease;
}

</style>

{% schema %}
{
  "name": "Technology Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technology That Listens To You"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
  {
    "type": "cta_slide",
    "name": "CTA Slide (Last)",
    "settings": [
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Small Heading",
        "default": "FIT AND COMFORT!"
      },
      {
        "type": "textarea",
        "id": "title",
        "label": "Main Title",
        "default": "Determine the size that provides the best seal and acoustic performance."
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "EAR FIT TEST"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "color",
        "id": "background",
        "label": "Background Color",
        "default": "#f2f2f2"
      }
    ]
  }
],
  "presets": [
    {
      "name": "Technology Slider",
    }
  ]
}
{% endschema %}
