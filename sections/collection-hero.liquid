<section class="collection-hero-section page-width">
  <div class="collection-hero collection-hero__content">
    <h1>{{ section.settings.heading }}</h1>
  </div>
</section>

<style>
.collection-hero{
  position: relative;
  background-image: url({{ section.settings.hero_image | image_url: width: 2000 }});
  background-size: cover;
  background-position: center;
  border-radius: 40px;
  overflow: hidden;
  min-height: 420px;
  display: flex;
  align-items: center;
  padding: 80px 40px;
}

.collection-hero::before{
  content:"";
  position:absolute;
  inset:0;
  background: rgba(0,0,0,0.35);
}

.collection-hero__content{
  position: relative;
  z-index: 2;
}

.collection-hero h1{
  color:#fff;
  font-size:48px;
  line-height:1.2;
  font-weight:600;
  max-width: 500px;
  z-index: 1;
}

@media(max-width:768px){

.collection-hero{
  padding:40px;
  min-height:300px;
  border-radius:20px;
}

.collection-hero h1{
  font-size:32px;
}

}
</style>

{% schema %}
{
  "name": "Collection Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Hearing Aids With Trusted Expert Support"
    }
  ],
  "presets": [
    {
      "name": "Collection Hero"
    }
  ]
}
{% endschema %}