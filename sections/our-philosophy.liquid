<section class="soundlife-philosophy page-width section-space-two">
  <div class="soundlife-philosophy__container">

    <!-- LEFT MEDIA -->
    <div class="soundlife-philosophy__media">
      {% if section.settings.main_image != blank %}
          <img
            src="{{ section.settings.main_image | image_url: width: 900 }}"
            alt="{{ section.settings.main_image.alt | escape }}"
            loading="lazy"
          >
      {% endif %}

      {% if section.settings.device_image != blank %}
          <img
            src="{{ section.settings.device_image | image_url: width: 600 }}"
            alt="{{ section.settings.device_image.alt | escape }}" class="soundlife-philosophy__media-product"
            loading="lazy"
          >
      {% endif %}

      {% if section.settings.badge_text != blank %}
        <span class="badge badge-label-secondary">{{ section.settings.badge_text }}</span>
      {% endif %}
    </div>

    <!-- RIGHT CONTENT -->
    <div class="soundlife-philosophy__content">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="heading heading-left">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text_1 != blank %}
        <p>{{ section.settings.text_1 }}</p>
      {% endif %}

      {% if section.settings.text_2 != blank %}
        <p>{{ section.settings.text_2 }}</p>
      {% endif %}

      <div class="values">
        {% for block in section.blocks %}
          <div class="value">
            <h4>{{ block.settings.title }}</h4>
            <p class="value-highlight">{{ block.settings.subtitle }}</p>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "SoundLife Philosophy",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image (Doctor)"
    },
    {
      "type": "image_picker",
      "id": "device_image",
      "label": "Device Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "SINCE 2009"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sound is a"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "At SOUNDLIFE, we believe hearing well is fundamental to living well."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "Our team combines cutting-edge technology with genuine compassion."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Trust"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Built on transparency"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "SoundLife Philosophy",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
