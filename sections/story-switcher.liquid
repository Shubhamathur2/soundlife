<section class="story-wrap">
  <div class="page-width">
    <div class="story-box">
      <div class="eyebrow">{{ section.settings.top_label }}</div>
      <h2 class="heading heading-left">{{ section.settings.heading }}</h2>
      <div class="story-grid">
        <!-- LEFT -->
        <div>
          <img id="storyImage" class="story-img" src="" teaches="">
          <div id="storyLabel" class="eyebrow"></div>
          <div id="storyTitle" class="story-left-title"></div>
          <div id="storyDesc" class="story-left-desc"></div>
          <a id="storyLink" class="story-link" href="#"
            >Explore More
            <svg
              class="arrow-svg blue-svg"
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M3.75 9H14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9 3.75L14.25 9L9 14.25" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <div class="story-arrows">
            <button id="prevStory" class="arrow-btn prev">  </button>
            <button id="nextStory" class="arrow-btn next">  </button>
          </div>
        </div>
        <!-- RIGHT -->
        <div>
          {% for block in section.blocks %}
            <div
              class="story-card"
              data-img="{{ block.settings.image | image_url: width: 900 }}"
              data-label="{{ block.settings.label }}"
              data-title="{{ block.settings.title }}"
              data-desc="{{ block.settings.desc }}"
              data-link="{{ block.settings.link }}"
              {{ block.shopify_attributes }}
            >
              <h4>{{ block.settings.card_title }}</h4>
              <p>{{ block.settings.card_sub }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const cards = document.querySelectorAll('.story-card');
    const img = document.getElementById('storyImage');
    const label = document.getElementById('storyLabel');
    const title = document.getElementById('storyTitle');
    const desc = document.getElementById('storyDesc');
    const link = document.getElementById('storyLink');

    const prevBtn = document.getElementById('prevStory');
    const nextBtn = document.getElementById('nextStory');

    let currentIndex = 0;

    function activate(card, index) {
      cards.forEach((c) => c.classList.remove('active'));
      card.classList.add('active');

      img.src = card.dataset.img;
      label.textContent = card.dataset.label;
      title.textContent = card.dataset.title;
      desc.textContent = card.dataset.desc;
      link.href = card.dataset.link;

      currentIndex = index;
    }

    // Card click (existing behavior preserved)
    cards.forEach((card, index) => {
      card.onclick = () => activate(card, index);
    });

    // Arrow navigation
    nextBtn.onclick = () => {
      let nextIndex = (currentIndex + 1) % cards.length;
      activate(cards[nextIndex], nextIndex);
    };

    prevBtn.onclick = () => {
      let prevIndex = (currentIndex - 1 + cards.length) % cards.length;
      activate(cards[prevIndex], prevIndex);
    };

    // Default first
    if (cards.length) activate(cards[0], 0);
  });
</script>

{% schema %}
{
  "name": "Story Switcher",
  "settings": [
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "STORIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Sound Has a Story"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story Item",
      "settings": [
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title"
        },
        {
          "type": "text",
          "id": "card_sub",
          "label": "Card Subtitle"
        },
        { "type": "image_picker", "id": "image", "label": "Left Image" },
        { "type": "text", "id": "label", "label": "Left Small Label" },
        { "type": "text", "id": "title", "label": "Left Title" },
        { "type": "textarea", "id": "desc", "label": "Left Description" },
        { "type": "url", "id": "link", "label": "Explore Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story Switcher"
    }
  ]
}
{% endschema %}
