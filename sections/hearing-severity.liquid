{% schema %}
{
  "name": "Hearing Severity",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Severe Is It?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Severity Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mild"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hearing Severity"
    }
  ]
}
{% endschema %}

<section class="hearing-severity section-space-two">
  <div class="page-width">
     <div class="hearing-flex">
        <!-- LEFT IMAGE COLLAGE -->
        <div class="hs-left">
            {% if section.settings.image %}
            <img src="{{ section.settings.image | img_url: '800x' }}" alt="">
        {% endif %}
        </div>

        <!-- RIGHT CONTENT -->
        <div class="hs-right">
        <h2 class="heading heading-left">{{ section.settings.heading }}</h2>
        <p class="subtitle">{{ section.settings.subtext }}</p>

        <div class="hs-list">
            {% for block in section.blocks %}
            <div class="hs-item">
                <span class="dot"></span>
                <div>
                <h4>{{ block.settings.title }}</h4>
                <p>{{ block.settings.desc }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
        </div>
    </div>
  </div>
</section>

