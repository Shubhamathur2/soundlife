{% comment %}
  Angled CTA Section
{% endcomment %}

<section class="sl-cta-split">
  <div class="sl-cta-inner page-width">
    <!-- LEFT CONTENT -->
    <div class="sl-cta-content">
      {% if section.settings.heading != blank %}
        <h2>
          <em>{{ section.settings.heading }}</em>
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}

      {% if section.settings.btn_label != blank %}
        <a href="{{ section.settings.btn_link }}" class="sl-cta-btn">
          {{ section.settings.btn_label }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.33301 8H12.6663" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 3.33301L12.6667 7.99967L8 12.6663" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
      {% if section.settings.btn_label_2 != blank %}
        <a href="{{ section.settings.btn_link_2 }}" class="sl-cta-btn">
          {{ section.settings.btn_label_2 }}          
        </a>
      {% endif %}

      {% if section.settings.text_2 != blank %}
        <p>{{ section.settings.text_2 }}</p>
      {% endif %}
    </div>
  </div>

  <!-- RIGHT IMAGE -->
  <div class="sl-cta-image">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="">
    {% endif %}
  </div>

  <!-- WAVE -->
  {% if section.settings.wave_image != blank %}
    <img class="sl-wave-overlay" src="{{ section.settings.wave_image | image_url: width: 1400 }}">
  {% endif %}
</section>

<style></style>

{% schema %}
{
  "name": "Angled CTA Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better Hearing Is Priceless"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description"
    },
    
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Talk To a Hearing Care Expert"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "btn_label_2",
      "label": "Button Label 2",
      "default": "Talk To a Hearing Care Expert"
    },
    {
      "type": "url",
      "id": "btn_link_2",
      "label": "Button Link 2"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Image"
    },
    {
      "type": "image_picker",
      "id": "wave_image",
      "label": "Wave Overlay Image"
    }
  ],
  "presets": [
    {
      "name": "Angled CTA Section"
    }
  ]
}
{% endschema %}
