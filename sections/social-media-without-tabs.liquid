<section class="social-youtube-carousel">
  <div class="page-width">
    <div class="container">
      <div class="heading-section">
        {% if section.settings.heading != blank %}
          <h2 class="heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="description">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <div class="panel active">
        <div class="carousel">
          <button class="arrow prev">&#10094;</button>

          <div class="track youtube-slick-slider">
            {% assign youtube_blocks = 0 %}
          {% for block in section.blocks %}
            <a href="{{ block.settings.url }}" target="_blank" rel="noopener" class="card">
              <div class="card-inner">
                {% if block.settings.thumbnail %}
                  <img
                    src="{{ block.settings.thumbnail | image_url: width: 600 }}"
                    class="thumbnail"
                    loading="lazy"
                  >
                {% endif %}

                <svg class="play-btn" width="64" height="64" viewBox="0 0 64 64" fill="none">
                  <rect width="64" height="64" rx="32" fill="#FBFAF8" fill-opacity="0.2"/>
                  <path d="M28 23L42 32L28 41V23Z" fill="white" stroke="#FBFAF8" stroke-width="2"/>
                </svg>
              </div>
            </a>
          {% endfor %}  
          </div>

          <button class="arrow next">&#10095;</button>
          <div class="dots"></div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
(function () {
  function initYoutubeCarousel() {
    if (typeof jQuery === 'undefined' || typeof jQuery.fn.slick === 'undefined') {
      console.warn('Slick or jQuery not loaded yet');
      return;
    }

    var $ = jQuery;

    $('.youtube-slick-slider').each(function () {
      var $slider = $(this);

      // Prevent double init (Shopify editor safe)
      if ($slider.hasClass('slick-initialized')) {
        $slider.slick('unslick');
      }

      var $section = $slider.closest('.social-youtube-carousel');
      var $prev = $section.find('.prev');
      var $next = $section.find('.next');
      var $dots = $section.find('.dots');

      $slider.slick({
        slidesToShow: 3,
        slidesToScroll: 1,
        infinite: true,
        autoplay: false,
        speed: 500,
        arrows: true,
        dots: true,
        swipe: true,
        draggable: true,
        touchMove: true,
        swipeToSlide: true,
        cssEase: 'ease',
        adaptiveHeight: false,
        variableWidth: false,

        // Use your existing arrows & dots
        prevArrow: $prev,
        nextArrow: $next,
        appendDots: $dots,

        responsive: [
          {
            breakpoint: 1200,
            settings: {
              slidesToShow: 3
            }
          },
          {
            breakpoint: 992,
            settings: {
              slidesToShow: 2
            }
          },
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 1,   // 🔥 1 full card on mobile
              slidesToScroll: 1,
              centerMode: false,
              variableWidth: false
            }
          }
        ]
      });
    });
  }

  // Run on page load
  window.addEventListener('load', initYoutubeCarousel);

  // Shopify section reload support (CRITICAL)
  document.addEventListener('shopify:section:load', initYoutubeCarousel);
})();
</script>

{% schema %}
{
  "name": "YouTube Video Carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch Our Videos" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Latest from our YouTube" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "YouTube Video",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "YouTube Video URL"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail Image"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "YouTube Video Carousel"
    }
  ]
}
{% endschema %}