<div class="trial-section">
  <div class="trial-container page-width">

    <div class="trial-header">
      <h2 class="heading">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="timeline">

      {% for block in section.blocks %}

        {% assign remainder = forloop.index0 | modulo: 2 %}

        <div class="timeline-row {% if remainder != 0 %}reverse{% endif %}">

          <div class="trial-card">

            <div class="reason-label">
              {{ block.settings.reason }}
            </div>

            <h3>{{ block.settings.title }}</h3>

            <p>{{ block.settings.description }}</p>

            {% if block.settings.points != blank %}
              <ul>
                {% assign list = block.settings.points | newline_to_br | split:'<br />' %}
                {% for item in list %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}

            <p>{{ block.settings.description_2 }}</p>
          </div>

          <div class="trial-image">
            <img 
              src="{{ block.settings.image | image_url: width:900 }}"
              alt=""
            >
          </div>

          <div class="timeline-dot"></div>

        </div>

      {% endfor %}

    </div>

  </div>
</div>



{% schema %}
{
  "name":"Trial Timeline",
  "settings":[
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"Why This Trial Changes Everything"
    },
    {
      "type":"textarea",
      "id":"subheading",
      "label":"Subheading"
    }
  ],
  "blocks":[
    {
      "type":"reason",
      "name":"Reason",
      "settings":[
        {
          "type":"text",
          "id":"reason",
          "label":"Reason Label",
          "default":"Reason 01"
        },
        {
          "type":"text",
          "id":"title",
          "label":"Title"
        },
        {
          "type":"textarea",
          "id":"description",
          "label":"Description"
        },
        {
          "type":"textarea",
          "id":"points",
          "label":"Bullet Points (one per line)"
        },
         {
          "type":"textarea",
          "id":"description_2",
          "label":"Description"
        },
        {
          "type":"image_picker",
          "id":"image",
          "label":"Image"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"Trial Timeline"
    }
  ]
}
{% endschema %}