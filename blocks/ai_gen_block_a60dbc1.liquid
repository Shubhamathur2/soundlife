{% doc %}
  @prompt
    Create a "Commonly Compared Products" section with a grid of product comparison cards. Each card should display:- Product image with a heart/wishlist icon in the top right corner- Product title below the image- Star rating (out of 5 stars) with review count- Price in rupees (Rp format)- Green circular shopping cart button in the bottom right- Clean white cards with subtle shadows and rounded cornersInclude a right-side call-to-action box with:- Heading "Compare all the best hearing aids with actual prices."- Green "Compare Now" button with WhatsApp iconThe section should be responsive, display 3-4 products in a row on desktop, and stack on mobile. Use a modern, clean design with the green accent color (
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-compared-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-compared-products-container-{{ ai_gen_id }} {
    max-width: 1240px;
    margin: 0 auto;
  }

  .ai-compared-products-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-compared-products-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
  }

  .ai-compared-products-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-compared-products-grid-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .ai-compared-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 24px;
  }

  .ai-compared-product-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .ai-compared-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: 100%;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .ai-compared-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-compared-product-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-compared-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-compared-product-wishlist-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    background: {{ block.settings.wishlist_bg_color }};
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .ai-compared-product-wishlist-{{ ai_gen_id }}:hover {
    background: {{ block.settings.wishlist_hover_bg_color }};
  }

  .ai-compared-product-wishlist-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.wishlist_icon_color }};
    fill: none;
    stroke-width: 2;
  }

  .ai-compared-product-wishlist-{{ ai_gen_id }}.active svg {
    fill: {{ block.settings.wishlist_icon_color }};
  }

  .ai-compared-product-info-{{ ai_gen_id }} {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-compared-product-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    line-height: 1.4;
    min-height: 44px;
  }

  .ai-compared-product-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .ai-compared-product-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-compared-product-star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-compared-product-star-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.star_color }};
  }

  .ai-compared-product-star-{{ ai_gen_id }}.empty svg {
    fill: #e0e0e0;
  }

  .ai-compared-product-review-count-{{ ai_gen_id }} {
    font-size: 13px;
    color: #666;
  }

  .ai-compared-product-footer-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .ai-compared-product-price-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
  }

  .ai-compared-product-cart-btn-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    background: {{ block.settings.cart_button_color }};
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-compared-product-cart-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.cart_button_hover_color }};
  }

  .ai-compared-product-cart-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.cart_icon_color }};
    fill: none;
    stroke-width: 2;
  }

  .ai-compared-cta-box-{{ ai_gen_id }} {
    background: {{ block.settings.cta_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    padding: 32px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .ai-compared-cta-heading-{{ ai_gen_id }} {
    font-size: 22px;
    font-weight: 700;
    color: {{ block.settings.cta_heading_color }};
    margin: 0 0 20px;
    line-height: 1.4;
  }

  .ai-compared-cta-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: {{ block.settings.cta_button_color }};
    color: {{ block.settings.cta_button_text_color }};
    border: none;
    border-radius: {{ block.settings.cta_button_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
  }

  .ai-compared-cta-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.cta_button_hover_color }};
  }

  .ai-compared-cta-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.cta_button_text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-compared-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-compared-products-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-compared-products-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-compared-products-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<compared-products-{{ ai_gen_id }} class="ai-compared-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-compared-products-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-compared-products-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-compared-products-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-compared-products-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-compared-products-grid-wrapper-{{ ai_gen_id }}">
      <div class="ai-compared-products-grid-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign product = block.settings[product_key]
            assign rating_key = 'product_' | append: i | append: '_rating'
            assign rating = block.settings[rating_key]
            assign reviews_key = 'product_' | append: i | append: '_reviews'
            assign reviews = block.settings[reviews_key]
          %}

          {% if product != blank %}
            <div class="ai-compared-product-card-{{ ai_gen_id }}">
              <div class="ai-compared-product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-compared-product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {% else %}
                  <div class="ai-compared-product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                <button
                  class="ai-compared-product-wishlist-{{ ai_gen_id }}"
                  aria-label="Add to wishlist"
                  data-product-id="{{ product.id }}"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>
              </div>

              <div class="ai-compared-product-info-{{ ai_gen_id }}">
                <h3 class="ai-compared-product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
                    {{ product.title }}
                  </a>
                </h3>

                <div class="ai-compared-product-rating-{{ ai_gen_id }}">
                  <div class="ai-compared-product-stars-{{ ai_gen_id }}">
                    {% for star in (1..5) %}
                      <span class="ai-compared-product-star-{{ ai_gen_id }} {% if star > rating %}empty{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                      </span>
                    {% endfor %}
                  </div>
                  {% if reviews > 0 %}
                    <span class="ai-compared-product-review-count-{{ ai_gen_id }}">({{ reviews }})</span>
                  {% endif %}
                </div>

                <div class="ai-compared-product-footer-{{ ai_gen_id }}">
                  <div class="ai-compared-product-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </div>
                  <button
                    class="ai-compared-product-cart-btn-{{ ai_gen_id }}"
                    aria-label="Add to cart"
                    data-product-id="{{ product.id }}"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <circle cx="9" cy="21" r="1"></circle>
                      <circle cx="20" cy="21" r="1"></circle>
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% if block.settings.show_cta_box %}
          <div class="ai-compared-cta-box-{{ ai_gen_id }}">
            {% if block.settings.cta_heading != blank %}
              <h3 class="ai-compared-cta-heading-{{ ai_gen_id }}">{{ block.settings.cta_heading }}</h3>
            {% endif %}
            {% if block.settings.cta_button_text != blank %}
              <a
                href="{{ block.settings.cta_button_link }}"
                class="ai-compared-cta-button-{{ ai_gen_id }}"
              >
                {% if block.settings.show_whatsapp_icon %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                {% endif %}
                {{ block.settings.cta_button_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</compared-products-{{ ai_gen_id }}>

<script>
  (function() {
    class ComparedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupWishlistButtons();
        this.setupCartButtons();
      }

      setupWishlistButtons() {
        const wishlistButtons = this.querySelectorAll('.ai-compared-product-wishlist-{{ ai_gen_id }}');
        
        wishlistButtons.forEach(button => {
          button.addEventListener('click', function(e) {
            e.preventDefault();
            this.classList.toggle('active');
            const productId = this.getAttribute('data-product-id');
            console.log('Wishlist toggled for product:', productId);
          });
        });
      }

      setupCartButtons() {
        const cartButtons = this.querySelectorAll('.ai-compared-product-cart-btn-{{ ai_gen_id }}');
        
        cartButtons.forEach(button => {
          button.addEventListener('click', function(e) {
            e.preventDefault();
            const productId = this.getAttribute('data-product-id');
            console.log('Add to cart clicked for product:', productId);
          });
        });
      }
    }

    customElements.define('compared-products-{{ ai_gen_id }}', ComparedProducts{{ ai_gen_id }});
  })();
</script>

